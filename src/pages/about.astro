---
import StandardPageLayout from "../layouts/StandardPageLayout.astro";
const pageTitle = "About Me";
---
<StandardPageLayout pageTitle={pageTitle}>
    <div class="about-section">
        <p>
            I'm a game developer working on Unreal Engine 5 simulations and an independent stealth-action game.
            <br/><br/>
            My dream is to develop video games that inspire others with my older brother.
            <br/><br/>
            I currently live in Michigan.
            <br/><br/>
            <a href="/assets/documents/Rishi_Rallapalli_Resume-2026-Website.pdf">Resume</a>
        </p>
    </div>
    <div class="about-section">
        <h2 class="title is-4">Skills</h2>
        <ul>
            <li><strong>Programming:</strong> C/C++, C#, Python, SQL</li>
            <li><strong>Design:</strong> Design Process, Documentation</li>
            <li><strong>AI:</strong> Utility-Based Agents, Machine Learning, Computer Vision, Conversational AI</li>
            <li><strong>Game Development:</strong> Unity, Unreal Engine 5, GameMaker Studio 2, 3D Math, Linear Algebra, Calculus</li>
            <li><strong>Art:</strong> Blender, Autodesk Fusion, Adobe Creative Cloud</li>
        </ul>
    </div>
    <div class="about-section">
    <h2 class="title is-4">Publication</h2>
        <p>
            Lauren Grant, Rishi Rallapalli, et al. Crew Optimization & Augmentation Technologies (COAT) Data Validation Pilot
            Technical Report. July 2024. DCS Corporation.
        <p>
    </div>
    <div class="about-section">
        <h2 class="title is-4">Education</h2>
            <ul>
                <li><i>M.S.E. Computer Science</i> from University of Michigan (May 2026)</li>
                <li><i>B.S.E. Computer Science and Japanese</i> from University of Michigan (May 2025)</li>
            </ul>
    </div>
</StandardPageLayout>

<style is:global>
    body {
        background-color: rgb(186, 235, 186) !important;
        color: black !important;
        text-emphasis-color: black;
    }

    .about-section {
        background-color: rgb(217, 255, 217);
        padding: 1.5rem;
        margin: 1.5rem 0;
        border-radius: 8px;
        box-shadow: 6px 8px 0 rgba(0, 71, 32, 0.377);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .about-section:hover {
        box-shadow: 8px 10px 0 rgba(0, 71, 32, 0.377);
        transform: translate(-2px, -2px);
    }

    .iframe-container {
        display: block;
        justify-content: center;
        align-items: center;
        margin: 0 auto;
    }

    iframe {
        border: none;
        max-width: 100%;
        max-height: 100%;
    }

    .title {
        color: rgb(65, 65, 65) !important;
    }

    strong {
        color: black !important;
    }

    h3 {
        color: rgb(84, 77, 187) !important;
    }
</style>