---
import Hamburger from './Hamburger.astro'
import { getCollection } from "astro:content";
import SocialIcon from './SocialIcon.astro';

const projects = await getCollection('projects');

projects.sort((a, b) => {
    const aSort = a.data.sort ?? null;
    const bSort = b.data.sort ?? null;

    if (aSort !== null && bSort !== null) return aSort - bSort;
    if (aSort !== null) return -1
    if (bSort !== null) return 1

    const yearA = a.data.year === "TBA" ? 0 : Number(a.data.year);
    const yearB = b.data.year === "TBA" ? 0 : Number(b.data.year);
    return yearB - yearA;
});
---

<nav class="navbar" role="navigation" aria-label="main navigation">
    <div class="navbar-brand">
        <a class="navbar-item" href="/">
            <img src="/logo.png" alt="logo" style="max-height: 3rem;">
        </a>
        <Hamburger />
    </div>
    <div class="navbar-menu is-justify-content-center is-size-5 has-text-weight-bold is-uppercase" id="navMenu">
        <div class="navbar-end">
            </a>
            <a href="https://bsky.app/profile/delicateduck.bsky.social" class="navbar-item social-link" target="_blank" rel="noopener noreferrer">
                <SocialIcon platform="bluesky" />
            </a>
            <a class="navbar-item" href="/projects/">Projects</a>
            <a class="navbar-item" href="/art/">Art</a>
            <a class="navbar-item" href="/about/">About</a>
        </div>
    </div>
</nav>

<style>
    .navbar {
        position: relative;
        width: 100%;
        top: 0;
        margin: auto;
        max-width: 1280px;
    }

    .navbar-item, .navbar-link  {
        background-color: transparent !important;
        color: var(--primary-content-color)
    }
    
